    { "id": 2, "role": "index_flex",   "in1": 12, "in2": 13, "invert": false, "close_ms": 600, "open_ms": 720 },
    { "id": 3, "role": "middle_flex",  "in1": 33, "in2": 32, "invert": false, "close_ms": 600, "open_ms": 720 },
